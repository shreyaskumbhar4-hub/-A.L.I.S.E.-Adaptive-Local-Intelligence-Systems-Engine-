        <section id="demo">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 text-center">
                    <h3>Speech Recognition</h3>
                    <p>Our demo recognizes speech from microphone. Requires Google Chrome. Press a button and say something. The result will be displayed on the right.</p>
                    <button type="submit" class="btn big-btn" id="liveButton" onclick="switchListening()">Try Now</button>
                </div>
                <div class="col-6 offset-1">
                    <textarea class="form-control" id="dialog" rows="11"></textarea>
                </div>
            </div>
        </div>
        </section>



